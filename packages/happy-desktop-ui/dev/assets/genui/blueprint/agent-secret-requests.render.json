{
    "genuiRender": 1,
    "compiler": "1.0.0",
    "fallback": "Add Stripe test keys and replace the OpenAI key.",
    "root": "card",
    "elements": {
        "card": {
            "type": "box",
            "props": {
                "role": "card",
                "gap": "blocks"
            },
            "children": ["card.title", "card.body", "actions"]
        },
        "card.title": {
            "type": "text",
            "props": {
                "spans": [
                    {
                        "text": "Keys for the billing tests"
                    }
                ],
                "role": "title"
            }
        },
        "card.body": {
            "type": "text",
            "props": {
                "spans": [
                    {
                        "text": "The billing tests need Stripe test keys, and the OpenAI key I use for summaries was revoked. Values stay on this machine; I only learn which secret changed."
                    }
                ]
            }
        },
        "actions": {
            "type": "box",
            "props": {
                "role": "plain",
                "direction": "row",
                "gap": "items"
            },
            "children": ["add-stripe", "rotate-openai"]
        },
        "add-stripe": {
            "type": "button",
            "props": {
                "label": "Add Stripe keys",
                "icon": "lock",
                "variant": "primary",
                "action": {
                    "type": "secret",
                    "secret": {
                        "id": "stripe",
                        "description": "Stripe test-mode keys for the billing service",
                        "variables": [
                            {
                                "name": "STRIPE_SECRET_KEY",
                                "description": "Secret key, starts with sk_test_"
                            },
                            {
                                "name": "STRIPE_WEBHOOK_SECRET",
                                "description": "Signing secret of the webhook endpoint"
                            }
                        ]
                    }
                }
            }
        },
        "rotate-openai": {
            "type": "button",
            "props": {
                "label": "Replace OpenAI key",
                "icon": "sparkles",
                "variant": "secondary",
                "action": {
                    "type": "secret",
                    "secret": {
                        "id": "openai",
                        "variables": [
                            {
                                "name": "OPENAI_API_KEY",
                                "description": "A new key from platform.openai.com"
                            }
                        ]
                    }
                }
            }
        }
    }
}
