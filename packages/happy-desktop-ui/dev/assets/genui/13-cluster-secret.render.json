{
    "genuiRender": 1,
    "compiler": "1.0.0",
    "fallback": "Add a Stripe test key and replace the GitHub token for the billing repo.",
    "root": "card",
    "elements": {
        "card": {
            "type": "box",
            "props": {
                "role": "card",
                "gap": "blocks"
            },
            "children": ["card.title", "card.body", "actions"]
        },
        "card.title": {
            "type": "text",
            "props": {
                "spans": [
                    {
                        "text": "Two keys for the billing work"
                    }
                ],
                "role": "title"
            }
        },
        "card.body": {
            "type": "text",
            "props": {
                "spans": [
                    {
                        "text": "I need a Stripe test key to run the checkout flow, and the GitHub token I use for the billing repo has expired. Values go straight to the cluster; I never see them."
                    }
                ]
            }
        },
        "actions": {
            "type": "box",
            "props": {
                "role": "plain",
                "direction": "row",
                "gap": "items"
            },
            "children": ["add-stripe", "rotate-github"]
        },
        "add-stripe": {
            "type": "button",
            "props": {
                "label": "Add Stripe key",
                "icon": "lock",
                "variant": "primary",
                "action": {
                    "type": "cluster_secret",
                    "secret": {
                        "type": "endpoint",
                        "name": "Stripe test",
                        "description": "Stripe test-mode secret key for the checkout flow",
                        "uses": ["egress"],
                        "owner": "team",
                        "public": {
                            "targets": [
                                {
                                    "host": "api.stripe.com",
                                    "pathPrefixes": ["/v1"]
                                }
                            ],
                            "algorithm": {
                                "kind": "headers",
                                "headers": [
                                    {
                                        "name": "Authorization",
                                        "prefix": "Bearer "
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        "rotate-github": {
            "type": "button",
            "props": {
                "label": "Replace GitHub token",
                "icon": "git-branch",
                "variant": "secondary",
                "action": {
                    "type": "cluster_secret",
                    "secret": {
                        "id": "sec_github_billing",
                        "type": "git_credential",
                        "name": "GitHub billing",
                        "description": "Fine-grained token for slopus/billing"
                    }
                }
            }
        }
    }
}
