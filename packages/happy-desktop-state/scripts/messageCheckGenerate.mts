import { readFileSync, writeFileSync } from "node:fs";
import { TypeCompiler } from "@sinclair/typebox/compiler";
import { format, type FormatConfig } from "oxfmt";
import { messageSchema } from "../src/happyAgentConnection/messageSchema.js";
import { schemaShared } from "./schemaShared.mjs";

/*
 * Writes `messageSchema`'s check, compiled ahead of time, to
 * `src/happyAgentConnection/messageCheck.generated.js`: the renderer's content
 * security policy refuses the `new Function` `TypeCompiler.Compile` builds it
 * with. `--check` writes nothing and fails while the committed files differ.
 */

const directory = new URL("../src/happyAgentConnection/", import.meta.url);
const outputs = {
    module: new URL("messageCheck.generated.js", directory),
    declaration: new URL("messageCheck.generated.d.ts", directory),
};
const header = [
    "// Generated by `pnpm message-check:generate` from messageSchema.ts. Do not edit.",
    "// Run it again after changing the schema or upgrading @slopus/happy-agent-client.",
];

const code = TypeCompiler.Code(schemaShared(messageSchema), [], { language: "javascript" });
/* `Compile` passes these three in; only `hash` is a pure function this module can import. */
if (/\b(?:kind|format)\(/.test(code))
    throw new Error(
        "messageSchema uses a custom kind or string format, which a module cannot check",
    );
if (/\bnew Function\b|\beval\(/.test(code))
    throw new Error("the compiled check evaluates code, which the renderer refuses");

const files = {
    module: [
        ...header,
        "/* oxlint-disable -- compiler output */",
        ...(/\bhash\(/.test(code)
            ? ['import { Hash as hash } from "@sinclair/typebox/value";']
            : []),
        "",
        "export const messageCheck = (() => {",
        code,
        "})();",
    ].join("\n"),
    declaration: [
        ...header,
        "",
        "/** `Value.Check(messageSchema, value)`, compiled ahead of time. */",
        "export declare const messageCheck: (value: unknown) => boolean;",
    ].join("\n"),
};

const formatConfig = JSON.parse(
    readFileSync(new URL("../../../.oxfmtrc.json", import.meta.url), "utf8"),
) as FormatConfig & { $schema?: string; ignorePatterns?: string[] };
delete formatConfig.$schema;
delete formatConfig.ignorePatterns;

const stale: string[] = [];
for (const key of ["module", "declaration"] as const) {
    const path = outputs[key];
    const formatted = await format(path.pathname, files[key], formatConfig);
    if (formatted.errors.length > 0)
        throw new Error(`${path.pathname}: ${JSON.stringify(formatted.errors)}`);
    if (process.argv.includes("--check")) {
        let committed: string | undefined;
        try {
            // A checkout that writes CRLF holds the same file.
            committed = readFileSync(path, "utf8").replace(/\r\n/g, "\n");
        } catch {
            committed = undefined;
        }
        if (committed !== formatted.code) stale.push(path.pathname);
    } else writeFileSync(path, formatted.code);
}
if (stale.length > 0) {
    console.error(
        `${stale.join(", ")}: out of date with messageSchema; run \`pnpm message-check:generate\``,
    );
    process.exit(1);
}
