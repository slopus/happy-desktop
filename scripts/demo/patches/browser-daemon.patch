+/**
+ * The demo recorder's scripted local daemon, installed on `window` before the
+ * page's own scripts run.
+ *
+ * Browser-local development has no machine-local daemon lifecycle to report,
+ * so this bridge normally answers with a static unmanaged snapshot. The demo
+ * recorder, which drives this window to film the real update and restart
+ * surfaces, scripts that lifecycle instead: it publishes genuine
+ * `DesktopDaemonSnapshot` progressions (update available, downloaded,
+ * draining, restarting) while performing the actual daemon restart out of
+ * band. Only the snapshot source is scripted — every store, surface, and the
+ * retained application and reconnection are the production code paths.
+ */
+export interface BrowserDemoDaemon {
+    get(): DesktopDaemonSnapshot;
+    subscribe(listener: (snapshot: DesktopDaemonSnapshot) => void): () => void;
+    install(): Promise<void>;
+}
+
+declare global {
+    interface Window {
+        happyDemoDaemon?: BrowserDemoDaemon;
+    }
+}
