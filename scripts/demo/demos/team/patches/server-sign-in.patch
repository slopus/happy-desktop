+ * attached exactly as main attaches its own, and never reach the page.
+ */
+function demoServerSessions(): HappyAgentRemoteAuthorization | undefined {
+    const configured = process.env.HAPPY_DEMO_SERVER_CREDENTIALS;
+    if (!configured) return undefined;
+    const credentials = new Map(
+        Object.entries(JSON.parse(configured) as Record<string, ServerRemoteCredential>),
+    );
+    return {
+        credential: (connectionId) => credentials.get(connectionId),
+        refresh: async (connectionId) => credentials.get(connectionId),
+        signInRequire: () => undefined,
+        serverMoved: () => undefined,
+    };
+}
