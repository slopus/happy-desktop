+/**
+ * Demo recorder only: the browser-local window has no guest view, so an
+ * artifact's site is drawn in a frame instead. The site, the host styles and
+ * the inline fit are the product's; only the engine differs.
+ */
+const demoArtifactPageRender: HtmlPreviewRenderer = (props) => (
+    <iframe
+        src={props.source}
+        title="Artifact"
+        style={{ display: "block", width: "100%", height: "100%", border: 0, colorScheme: "dark" }}
+        onLoad={(event) => {
+            const frame = event.currentTarget;
+            const page = frame.contentDocument;
+            if (!page) return;
+            const style = page.createElement("style");
+            style.textContent = artifactPageHostStyle(frame, "inline");
+            page.head.prepend(style);
+            const report = () =>
+                props.fit?.heightChanged(Math.ceil(page.body.getBoundingClientRect().height));
+            new ResizeObserver(report).observe(page.body);
+            report();
+            props.previewLoaded();
+        }}
+    />
+);
