diff --git a/dist/protocol/viewers.d.ts b/dist/protocol/viewers.d.ts
new file mode 100644
index 000000000..4cec2134c
--- /dev/null
+++ b/dist/protocol/viewers.d.ts
@@ -0,0 +1,34 @@
+/** What a person can be viewing: an agent session or a Surface. */
+export type ViewerTarget = {
+    type: "agent";
+    id: string;
+} | {
+    type: "surface";
+    id: string;
+};
+/**
+ * One other person who views a target now, or did. `lastSeenAt` is the last moment
+ * they were here, epoch milliseconds; for a person here now it is the server's time.
+ */
+export interface Viewer {
+    userId: string;
+    here: boolean;
+    lastSeenAt: number;
+}
+/** `PUT /v0/viewers/streams/:streamId` body: everything this stream views, 0 to 8 targets. */
+export interface PutViewersRequest {
+    targets: ViewerTarget[];
+}
+/** The viewers of one requested target, the caller excluded: here first, then newest. */
+export interface TargetViewers {
+    target: ViewerTarget;
+    viewers: Viewer[];
+}
+export interface PutViewersResponse {
+    targets: TargetViewers[];
+}
+/** `viewers.updated`: a person started or stopped being here. No cursor, never replayed. */
+export interface ViewersUpdatedFrame {
+    target: ViewerTarget;
+    viewer: Viewer;
+}
